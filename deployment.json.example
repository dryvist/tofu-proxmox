      },
      "hostname": "authelia",
      "description": "Authelia SSO portal / Traefik forwardAuth provider \u2014 criticality-1 core service (auth plane, beside ingress/DNS): native Go binary, portal + authz API on 9091 fronted by Traefik; passkey-first login; state in local SQLite on persistent /var/lib/authelia.",
      "cpu_cores": 1,
      "memory_dedicated": 512,
      "tags": [
        "terraform",
        "container",
        "authelia"
      ],
      "pool_id": "infrastructure",
      "node_name": "proxmox-1",
