      "node_name": "proxmox-1",
      "dhcp": true,
      "vlan": "ai",
      "hostname": "ai-runner-terrakube-01",
      "description": "Headless OpenTofu runner \u2014 drives `tofu` against the private Terrakube backend, confined by the ai-terrakube firewall profile (internal-only egress, no WAN). Converged by the ansible-proxmox-ai ai_runner role.",
      "cpu_cores": 4,
      "memory_dedicated": 8192,
      "tags": [
        "terraform",
        "container",
        "ai",
        "ai-runner",
        "ai-terrakube"
