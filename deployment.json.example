  "containers": {
    "_placement_comment": "node_name is REQUIRED on every entry. It used to be optional, with tofu falling back to proxmox_node when it was absent \u2014 which meant a guest that simply never named a node was indistinguishable from one deliberately placed on the primary, and nothing anywhere reported the difference. That fallback is how the primary node came to hold the majority of the estate's containers, log pipeline included. There is no default to inherit now: name the node, and name it for a reason (spare memory, spare CPU, or keeping the two halves of a redundant pair apart).",
    "example-container": {
      "vm_id": 100,
      "node_name": "proxmox-1",
      "vlan": "apps",
      "hostname": "example-container",
      "description": "Example LXC container entry \u2014 replace with your own",
      "cpu_cores": 1,
      "memory_dedicated": 512,
      "tags": [
        "terraform",
        "container"
      ],
      "pool_id": "infrastructure",
      "root_disk": {
        "size": 8
      }
    },
    "_ipam_dcim_comment": "Shared Postgres (data VLAN) + native Nautobot IPAM/DCIM (apps VLAN). Both DHCP/DNS-first (a plain pool lease, no declared address); VMIDs follow the tier-positional scheme (3=data, 6=apps). Native installs \u2014 no `features.nesting` (not Docker-in-LXC). Postgres carries a persistent /var/lib/postgresql data mount (survives rebuilds); Nautobot a /opt/nautobot mount and colocated Redis. Postgres has NO Traefik ingress (in-cluster 5432 only); Nautobot's web UI (8080) is fronted by Traefik. Illustrative placeholders only \u2014 the live values live in the gitignored deployment.json.",
    "postgres": {
      "vm_id": 303000,
      "dhcp": true,
      "vlan": "data",
      "hostname": "postgres",
      "description": "Shared native Postgres \u2014 inventory/apps datastore (Nautobot now; Vikunja/EspoCRM later). Persistent data mount + pgdump backups.",
      "cpu_cores": 2,
      "memory_dedicated": 2048,
      "tags": [
        "terraform",
        "container",
        "postgres"
      ],
      "pool_id": "infrastructure",
      "node_name": "proxmox-1",
      "unprivileged": true,
      "root_disk": {
        "size": 16
      },
      "mount_points": [
        {
          "volume": "local-zfs",
          "size": "60G",
          "path": "/var/lib/postgresql"
        }
      ]
    },
    "postgres-apps": {
