      "hostname": "glance",
      "description": "Glance dashboard \u2014 single Go binary, web UI on 8080 fronted by Traefik; glance.yml on rootfs (no mount point, same reason as homarr); generated content kept in an included file so hand-written widgets survive a re-render.",
      "cpu_cores": 1,
      "memory_dedicated": 512,
