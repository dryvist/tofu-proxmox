use flake "github:dryvist/nix-devenv?dir=shells/tofu"

export PCT_TFPATH=tofu

# Terrakube remote-backend coordinates (TF_CLOUD_HOSTNAME, TF_CLOUD_ORGANIZATION)
# and the dynamic Terraform workspace (TF_WORKSPACE) come from the nix-devenv
# tofu devShell's shellHook, so this file stays generic and completely DRY.
# The helper binary is the pre-shellHook source of the same values; it is only
# invoked while it still exists, so this file works against either revision of
# the shell.
if command -v export-terrakube-env >/dev/null 2>&1; then
  eval "$(export-terrakube-env)"
fi
